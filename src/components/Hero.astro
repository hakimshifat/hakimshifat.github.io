---
/**
 * Hero — Full-viewport intro section.
 * Two-column layout: text left, photo right (stacked on mobile).
 * All personal data extracted from existing codebase.
 */
import { Image } from 'astro:assets';
import profileImage from '../assets/abdulhakim.png';
---

<section id="hero" class="min-h-screen flex items-center pt-16">
  <div class="max-w-[1100px] mx-auto px-6 w-full py-16 md:py-0">
    <div class="grid md:grid-cols-[1fr_auto] gap-12 md:gap-16 items-center">
      <!-- Text content -->
      <div class="order-2 md:order-1">
        <div class="flex flex-wrap items-center gap-3 mb-6 reveal">
          <p class="text-xs font-mono uppercase tracking-[0.25em] text-blue-400">
            Security Researcher · Software Engineer · CTF Player
          </p>
          <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-amber-300/80 border-l border-amber-300/30 pl-3">Voyage Log // 01</span>
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-[0.95] mb-8 reveal">
          Abdul Hakim<br />
          <span class="text-zinc-500">Shifat</span>
        </h1>

        <p class="text-lg text-zinc-400 leading-relaxed max-w-lg mb-6 reveal">
          I build security tools, solve CTF challenges, and explore Linux and
          low-level systems with a planner's patience. The work blends software
          engineering, research, and open-source craftsmanship.
        </p>

        <p class="max-w-lg border-l border-blue-500/50 pl-4 text-sm leading-relaxed text-zinc-500 mb-8 reveal">
          Open to security engineering, vulnerability research, systems programming,
          and open-source opportunities.
        </p>

        <div class="grid grid-cols-3 gap-3 max-w-lg mb-10 reveal" aria-label="Selected proof points">
          <div class="border border-zinc-800 rounded-lg px-3 py-3">
            <p class="text-lg font-semibold text-white">#49</p>
            <p class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Global CTF</p>
          </div>
          <div class="border border-zinc-800 rounded-lg px-3 py-3">
            <p class="text-lg font-semibold text-white">#3</p>
            <p class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Bangladesh</p>
          </div>
          <div class="border border-zinc-800 rounded-lg px-3 py-3">
            <p class="text-lg font-semibold text-white">20+</p>
            <p class="text-[10px] font-mono uppercase tracking-wider text-zinc-500">Notes & projects</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 reveal">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium rounded-lg transition-colors duration-200"
          >
            View My Work
            <!-- Down-arrow icon -->
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <!-- TODO: Place your actual resume PDF at public/resume.pdf -->
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border border-zinc-700 hover:border-zinc-500 text-zinc-300 hover:text-white text-sm font-medium rounded-lg transition-all duration-200"
          >
            Download Resume
            <!-- Download icon -->
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
          <a
            href="https://github.com/hakimshifat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border border-zinc-700 hover:border-zinc-500 text-zinc-300 hover:text-white text-sm font-medium rounded-lg transition-all duration-200"
          >
            GitHub
            <!-- External-link icon -->
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Profile photo -->
      <div class="order-1 md:order-2 flex justify-center md:justify-end reveal">
          <div class="relative">
          <div class="absolute -top-7 -left-7 hidden md:block rotate-[-7deg] rounded border border-amber-300/40 bg-[#f4c95d] px-3 py-2 text-center text-[#102a3c] shadow-lg shadow-black/20" aria-hidden="true">
            <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em]">Wanted</p>
            <p class="mt-1 font-serif text-[9px] uppercase tracking-wider">For Curiosity</p>
          </div>
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-2xl overflow-hidden border border-zinc-800 shadow-2xl shadow-blue-500/5 bg-zinc-900">
            <Image
              src={profileImage}
              alt="Abdul Hakim Shifat"
              class="w-full h-full object-cover"
              width={256}
              height={256}
              loading="eager"
            />
          </div>
          <!-- Decorative offset border -->
          <div class="absolute -bottom-3 -right-3 w-48 h-48 md:w-64 md:h-64 rounded-2xl border border-blue-500/30 -z-10" aria-hidden="true"></div>
          <div class="absolute -bottom-5 -left-8 hidden md:block text-[10px] font-mono uppercase tracking-[0.2em] text-amber-300/70" aria-hidden="true">// charting unknown waters</div>
        </div>
      </div>
    </div>
  </div>
</section>
