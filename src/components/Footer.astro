---
/**
 * Footer — Minimal site footer with copyright and social links.
 */
---

<footer class="py-12 border-t border-zinc-800">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-zinc-500 font-mono">
        © 2026 Abdul Hakim Shifat
      </p>
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/hakimshifat"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-zinc-500 hover:text-white transition-colors duration-200"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/hakimshifat"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-zinc-500 hover:text-white transition-colors duration-200"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</footer>
