---
/**
 * Projects — Card grid showcasing key projects.
 * Data sourced from src/content/projects/ markdown files.
 * Images are lazy-loaded; first project image is above fold on desktop.
 */
const projects = [
  {
    title: 'YTUI Music',
    description:
      'A terminal-based YouTube audio player built with Textual, mpv, and yt-dlp. Keyboard-first, resource-efficient alternative to browser-based music listening. Published on the AUR.',
    tags: ['Python', 'Textual', 'TUI', 'YouTube', 'MPV'],
    image: '/images/projects/yt2.png',
    link: 'https://github.com/hakimshifat/ytui_music',
  },
  {
    title: 'Tiny x64 Bootloader',
    description:
      'A minimal 512-byte x64 boot sector demonstrating BIOS boot process fundamentals including real mode initialization, segment register setup, and stack configuration.',
    tags: ['Assembly', 'x86_64', 'Low-Level', 'OS Dev'],
    image: '/images/projects/x86.png',
    link: 'https://github.com/hakimshifat/Tiny-x64-Bootloader',
  },
  {
    title: 'Personal Portfolio & Blog',
    description:
      'Theme-driven site that dynamically renders content from an Obsidian vault, automating the pipeline from private technical notes to public blog posts.',
    tags: ['Astro', 'Obsidian', 'Tailwind'],
    image: '/images/projects/port.png',
    link: 'https://github.com/hakimshifat/hakimshifat.github.io',
  },
  {
    title: 'soc-triage-calibration',
    description:
      'Engineering package for SOC L1 automation research, supporting dataset provenance auditing, independent split validation, selective-prediction evaluation, and adversarial prompt-injection experiments.',
    tags: ['Python', 'SOC', 'Calibration', 'Dataset Auditing', 'Security Research'],
    visual: 'SOC / EVALUATION',
    link: 'https://github.com/hakimshifat/soc-triage-calibration',
  },
  {
    title: 'Meme Mirror Local',
    description:
      'A Linux Python camera application that turns meme or anime reaction images into local rehearsal prompts, then scores a user-taught face and hand pose against the reference.',
    tags: ['Python', 'OpenCV', 'MediaPipe', 'Local AI', 'Anime'],
    visual: 'VISION / ANIME',
    link: 'https://github.com/hakimshifat/meme-mirror-local',
  },
  {
    title: 'aurscan',
    description:
      'A local, CLI-first, evidence-based scanner for Arch Linux AUR recipes that statically inspects PKGBUILD, .install, .SRCINFO, sources, and recipe commands without executing them.',
    tags: ['Python', 'CLI', 'Arch Linux', 'Static Analysis', 'SARIF'],
    visual: 'AUR / STATIC ANALYSIS',
    link: 'https://github.com/hakimshifat/aurscan',
  },
  {
    title: 'SWE-Project',
    description:
      'Secure Information Hiding System Using Steganography: a full-stack application for hiding text or files inside PNG/BMP images with optional password protection and later extraction.',
    tags: ['React', 'TypeScript', 'Express', 'PostgreSQL', 'Steganography'],
    visual: 'STEGANOGRAPHY / WEB APP',
    link: 'https://github.com/hakimshifat/SWE-Project',
  },
];
---

<section id="projects" class="py-24 md:py-32">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-xs font-mono text-blue-400 tracking-wider">03</span>
      <div class="h-px flex-1 bg-zinc-800"></div>
      <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-500">Projects</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6 stagger">
      {projects.map(project => {
        const CardTag = project.link ? 'a' : 'article';
        const cardProps = project.link ? { href: project.link, target: "_blank", rel: "noopener noreferrer" } : {};

        return (
          <CardTag {...cardProps} class={`group block border border-zinc-800 rounded-xl overflow-hidden hover:border-zinc-700 hover:bg-zinc-900/30 transition-all duration-300 reveal flex flex-col h-full ${project.link ? 'cursor-pointer' : ''}`}>
            {project.image ? (
              <div class="aspect-video overflow-hidden bg-zinc-900 border-b border-zinc-800 shrink-0">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="project-visual aspect-video bg-zinc-900 flex flex-col items-center justify-center border-b border-zinc-800 shrink-0">
                <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-blue-400">Project note</span>
                <span class="mt-3 max-w-[80%] text-center text-sm font-mono uppercase tracking-wider text-zinc-500">{project.visual || 'Technical project'}</span>
              </div>
            )}

            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-4 mb-3">
                <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-200">
                  {project.title}
                </h3>
                {project.link && (
                  <span class="shrink-0 text-zinc-500 group-hover:text-blue-400 transition-colors duration-200">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10" />
                    </svg>
                  </span>
                )}
              </div>

              <p class="text-sm text-zinc-400 leading-relaxed mb-4">{project.description}</p>

              <div class="flex flex-wrap gap-2 mt-auto">
                {project.tags.map(tag => (
                  <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 bg-zinc-800/50 px-2.5 py-1 rounded-md">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </CardTag>
        );
      })}
    </div>
  </div>
</section>

<style is:global>
  .project-visual {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 22%, rgba(201, 151, 255, 0.18), transparent 12rem),
      radial-gradient(circle at 20% 80%, rgba(255, 143, 174, 0.1), transparent 14rem),
      #151621;
  }

  .project-visual::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0.38;
    background-image:
      linear-gradient(rgba(201, 151, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 151, 255, 0.12) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(135deg, black, transparent 78%);
  }

  .project-visual > * {
    position: relative;
    z-index: 1;
  }
</style>
