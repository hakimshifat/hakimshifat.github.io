---
/**
 * Skills — Categorized skill pills + certifications.
 * Data sourced from about.astro and _coding-profiles.astro.
 */
const skillCategories = [
  {
    label: 'Languages',
    skills: ['C', 'C++', 'Python', 'Java', 'JavaScript', 'SQL', 'x86 Assembly'],
  },
  {
    label: 'Frontend',
    skills: ['Astro', 'React', 'TypeScript', 'Tailwind CSS', 'HTML5', 'CSS3'],
  },
  {
    label: 'Systems & Security',
    skills: ['Linux', 'Docker', 'IDA', 'Burpsuite', 'Wireshark', 'Reverse Engineering'],
  },
  {
    label: 'Tools & Platforms',
    skills: ['Git', 'VS Code', 'Django', 'PostgreSQL', 'AWS', 'QEMU'],
  },
];

const certifications = [
  {
    title: 'Certified Red Team Operations Management (CRTOM)',
    issuer: 'Red Team Leaders',
    date: 'Dec 2025',
  },
  {
    title: 'Problem Solving (Intermediate)',
    issuer: 'HackerRank',
    date: 'Jan 2025',
  },
  {
    title: 'Linux 100',
    issuer: 'TCM Security',
    date: 'Dec 2024',
  },
];
---

<section id="skills" class="py-24 md:py-32">
  <div class="max-w-[1100px] mx-auto px-6">
    <!-- Section header -->
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-xs font-mono text-blue-400 tracking-wider">04</span>
      <div class="h-px flex-1 bg-zinc-800"></div>
      <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-500">Skills & Certifications</h2>
    </div>

    <!-- Skill categories -->
    <div class="grid md:grid-cols-2 gap-10 mb-16 stagger">
      {skillCategories.map(category => (
        <div class="reveal">
          <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-zinc-500 mb-4">{category.label}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map(skill => (
              <span class="text-sm text-zinc-300 bg-zinc-800/60 border border-zinc-800 px-3 py-1.5 rounded-lg hover:border-zinc-600 hover:text-white transition-all duration-200 cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications -->
    <div class="reveal">
      <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-zinc-500 mb-6">Certifications</h3>
      <div class="space-y-3">
        {certifications.map(cert => (
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 p-4 border border-zinc-800 rounded-lg hover:border-zinc-700 transition-colors duration-200">
            <div>
              <p class="text-sm font-medium text-white">{cert.title}</p>
              <p class="text-xs text-zinc-500 mt-0.5">{cert.issuer}</p>
            </div>
            <span class="text-xs font-mono text-zinc-500 shrink-0">{cert.date}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
