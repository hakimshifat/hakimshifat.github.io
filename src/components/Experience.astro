---
import { experiences } from '../data/experience';
---

<section id="experience" class="py-24 md:py-32">
  <div class="max-w-[1100px] mx-auto px-6">
    <!-- Section header -->
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-xs font-mono text-blue-400 tracking-wider">01</span>
      <div class="h-px flex-1 bg-zinc-800"></div>
      <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-500">Experience</h2>
    </div>

    <div class="space-y-6 stagger">
      {experiences.map(exp => (
        <article class="group p-6 md:p-8 border border-zinc-800 rounded-xl hover:border-zinc-700 transition-all duration-300 reveal">
          {/* Header row: role + duration */}
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
            <div>
              <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-200">
                {exp.role}
              </h3>
              <p class="text-zinc-400 mt-1">
                {exp.link ? (
                  <a
                    href={exp.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-blue-400 transition-colors duration-200"
                  >
                    @ {exp.company} ↗
                  </a>
                ) : (
                  <span>@ {exp.company}</span>
                )}
              </p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-xs font-mono text-zinc-500">{exp.duration}</span>
              {exp.current && (
                <span class="text-[10px] font-mono uppercase tracking-wider text-blue-400 bg-blue-400/10 px-2 py-0.5 rounded-full border border-blue-400/20">
                  Current
                </span>
              )}
            </div>
          </div>

          {/* Description */}
          <p class="text-sm text-zinc-400 leading-relaxed mb-4">{exp.description}</p>

          {/* Impact badge */}
          {exp.impact && (
            <p class="text-xs font-mono text-blue-400 mb-4">↳ {exp.impact}</p>
          )}

          {/* Tags */}
          <div class="flex flex-wrap gap-2">
            {exp.tags.map(tag => (
              <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 bg-zinc-800/50 px-2.5 py-1 rounded-md">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
