---
/**
 * Achievements — CTF competition results in a responsive grid.
 * Data sourced from achievements.astro page.
 * Subtle badges distinguish competition categories within the shared dark palette.
 */
const achievements = [
  { title: 'TexSAW 2026',               position: '22nd',         date: 'Feb 2026',  type: 'International' },
  { title: 'UMDCTF 2026',               position: '21st',         date: '2026',       type: 'International' },
  { title: 'CTF@AC26 — Quals',          position: '22nd',         date: '2026',       type: 'International' },
  { title: 'squ1rrel CTF 2026',         position: '43rd',         date: '2026',       type: 'International' },
  { title: 'pingCTF 2026',              position: '44th',         date: '2026',       type: 'International' },
  { title: 'BUET CTF',                   position: '7th',          date: 'Jan 2026',  type: 'National' },
  { title: 'Al-Khwarizmi CTF 2025',     position: '11th',         date: 'Dec 2025',  type: 'National' },
  { title: 'Circuit Clash 1.0 CTF',     position: '6th',          date: 'Nov 2025',  type: 'National' },
  { title: 'DIU CyberCon CTF',          position: '7th',          date: 'Oct 2025',  type: 'National' },
  { title: 'ICPC Asia Dhaka Regional',  position: 'Participated', date: '2023-2025', type: 'ICPC' },
];

/** Returns Tailwind classes for the type badge based on competition type. */
function badgeClasses(type: string): string {
  switch (type) {
    case 'International':
      return 'text-blue-400 bg-blue-400/10 border-blue-400/20';
    case 'National':
      return 'text-zinc-300 bg-zinc-400/10 border-zinc-400/20';
    default:
      return 'text-zinc-500 bg-zinc-500/10 border-zinc-500/20';
  }
}
---

<section id="achievements" class="py-24 md:py-32">
  <div class="max-w-[1100px] mx-auto px-6">
    <!-- Section header -->
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-xs font-mono text-blue-400 tracking-wider">07</span>
      <div class="h-px flex-1 bg-zinc-800"></div>
      <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-500">Achievements</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger">
      {achievements.map(item => (
        <div class="group p-5 border border-zinc-800 rounded-xl hover:border-zinc-700 transition-all duration-300 reveal">
          <div class="flex items-start justify-between gap-3 mb-3">
            <h3 class="text-sm font-medium text-white leading-snug">{item.title}</h3>
            <span class={`shrink-0 text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full border ${badgeClasses(item.type)}`}>
              {item.type}
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xl font-bold text-blue-400">{item.position}</span>
            <span class="text-xs font-mono text-zinc-500">{item.date}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
