---
interface Props {
	targetId: string;
	text?: string;
	color?: string;
	startDir?: 'top' | 'bottom' | 'left' | 'right';
	endDir?: 'top' | 'bottom' | 'left' | 'right';
	spacing?: string;
	strokeWidth?: string;
	headSize?: string;
}

const { 
	targetId, 
	text = '', 
	color = 'var(--accent)', 
	startDir = 'right', 
	endDir = 'left', 
	spacing = '20',
	strokeWidth = '2',
	headSize = '10'
} = Astro.props;
---

<div 
	class="arrow-note hidden lg:block absolute pointer-events-none whitespace-nowrap font-primary text-xs text-[var(--ink-secondary)]" 
	data-target-id={targetId}
	data-color={color}
	data-start-dir={startDir}
	data-end-dir={endDir}
	data-spacing={spacing}
	data-stroke-width={strokeWidth}
	data-head-size={headSize}
	style={`color: ${color}; transform: translateX(100%) translateY(-50%); right: -40px; top: 50%;`}
>
	{text}
</div>

<script>
	// Arrow rendering logic is loaded globally in Layout or here
	if (!window.arrowsInitialized) {
		window.arrowsInitialized = true;
		
		const arrows: any[] = [];
		const boilFrames = [
			{ frequency: "0.018 0.026", lineScale: "3.2", seed: "2" },
			{ frequency: "0.028 0.018", lineScale: "4.1", seed: "5" },
			{ frequency: "0.014 0.032", lineScale: "3.7", seed: "8" },
			{ frequency: "0.024 0.022", lineScale: "4.5", seed: "13" }
		];
		const boilFilters: any[] = [];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		
		function initArrows() {
			const notes = document.querySelectorAll('.arrow-note');
			notes.forEach((note: any) => {
				if (note.dataset.processed) return;
				const target = document.getElementById(note.dataset.targetId);
				if (target) registerArrow(note, target);
			});
		}

		function ensureBoilFilters(svg: any) {
			let defs = document.getElementById('arrow-note-boil-defs');
			if (!defs) {
				defs = document.createElementNS("http://www.w3.org/2000/svg", "defs");
				defs.id = "arrow-note-boil-defs";
				svg.appendChild(defs);
				
				const filter = document.createElementNS("http://www.w3.org/2000/svg", "filter");
				filter.id = "arrow-note-line-boil";
				filter.setAttribute("x", "-28%");
				filter.setAttribute("y", "-28%");
				filter.setAttribute("width", "156%");
				filter.setAttribute("height", "156%");

				const turbulence = document.createElementNS("http://www.w3.org/2000/svg", "feTurbulence");
				turbulence.setAttribute("type", "turbulence");
				turbulence.setAttribute("baseFrequency", boilFrames[0].frequency);
				turbulence.setAttribute("numOctaves", "2");
				turbulence.setAttribute("seed", boilFrames[0].seed);
				turbulence.setAttribute("result", "noise");

				const displacement = document.createElementNS("http://www.w3.org/2000/svg", "feDisplacementMap");
				displacement.setAttribute("in", "SourceGraphic");
				displacement.setAttribute("in2", "noise");
				displacement.setAttribute("scale", boilFrames[0].lineScale);
				displacement.setAttribute("xChannelSelector", "R");
				displacement.setAttribute("yChannelSelector", "G");

				filter.appendChild(turbulence);
				filter.appendChild(displacement);
				defs.appendChild(filter);
				
				boilFilters.push({ filter, turbulence, displacement });
			}
		}

		function registerArrow(note: any, target: any) {
			let svg = document.getElementById('arrow-layer');
			if (!svg) {
				svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
				svg.id = "arrow-layer";
				svg.style.position = "absolute";
				svg.style.top = "0";
				svg.style.left = "0";
				svg.style.width = "100%";
				svg.style.height = "100%";
				svg.style.pointerEvents = "none";
				svg.style.zIndex = "900";
				svg.style.overflow = "visible";
				document.body.appendChild(svg);
			}

			ensureBoilFilters(svg);

			const group = document.createElementNS("http://www.w3.org/2000/svg", "g");
			// Optional: apply the boiling filter to the group if desired
			// group.style.filter = "url(#arrow-note-line-boil)";
			
			const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
			path.setAttribute("fill", "none");
			path.setAttribute("stroke", note.dataset.color);
			path.setAttribute("stroke-width", note.dataset.strokeWidth);
			path.setAttribute("stroke-linecap", "round");

			const head = document.createElementNS("http://www.w3.org/2000/svg", "path");
			head.setAttribute("fill", "none");
			head.setAttribute("stroke", note.dataset.color);
			head.setAttribute("stroke-width", note.dataset.strokeWidth);
			head.setAttribute("stroke-linecap", "round");
			head.setAttribute("stroke-linejoin", "round");

			group.appendChild(path);
			group.appendChild(head);
			group.style.opacity = "0";
			group.style.transition = "opacity 0.2s ease";
			svg.appendChild(group);

			arrows.push({
				note,
				target,
				group,
				path,
				head,
				config: {
					startDir: note.dataset.startDir,
					endDir: note.dataset.endDir,
					headSize: parseFloat(note.dataset.headSize),
					spacing: parseFloat(note.dataset.spacing)
				}
			});
			
			note.dataset.processed = "true";
		}

		function loop() {
			const scrollX = window.scrollX;
			const scrollY = window.scrollY;
			const boilFrame = boilFrames[Math.floor(performance.now() / 120) % boilFrames.length];

			arrows.forEach(arrow => {
				const { note, target, config } = arrow;
				if (!note.offsetParent) {
					arrow.nextState = { visible: false };
					return;
				}

				const r1 = note.getBoundingClientRect();
				const r2 = target.getBoundingClientRect();
				
				let x1 = r1.left + r1.width / 2 + scrollX;
				let y1 = r1.top + r1.height / 2 + scrollY;
				let x2 = r2.left + r2.width / 2 + scrollX;
				let y2 = r2.top + r2.height / 2 + scrollY;
				
				// Simplified math for demo purposes, adjust based on actual directions
				if (config.startDir === 'left') x1 = r1.left - config.spacing + scrollX;
				if (config.endDir === 'right') x2 = r2.right + config.spacing + scrollX;

				const cp1x = x1 - 30;
				const cp1y = y1;
				const cp2x = x2 + 30;
				const cp2y = y2;
				
				const d = `M ${x1} ${y1} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${x2} ${y2}`;
				
				const angle = Math.atan2(y2 - cp2y, x2 - cp2x);
				const headLen = config.headSize;
				const headAngle = Math.PI / 6;

				const p1x = x2 - headLen * Math.cos(angle - headAngle);
				const p1y = y2 - headLen * Math.sin(angle - headAngle);
				const p2x = x2 - headLen * Math.cos(angle + headAngle);
				const p2y = y2 - headLen * Math.sin(angle + headAngle);

				const headD = `M ${p1x} ${p1y} L ${x2} ${y2} L ${p2x} ${p2y}`;
				
				arrow.nextState = { visible: true, d, headD };
			});

			if (!reduceMotion.matches) {
				boilFilters.forEach(filter => {
					if (filter.turbulence.getAttribute("baseFrequency") !== boilFrame.frequency) {
						filter.turbulence.setAttribute("baseFrequency", boilFrame.frequency);
						filter.turbulence.setAttribute("seed", boilFrame.seed);
						filter.displacement.setAttribute("scale", boilFrame.lineScale);
					}
				});
			}

			arrows.forEach(arrow => {
				const { group, path, head, nextState, currentState } = arrow;
				if (!nextState) return;
				if (!nextState.visible) {
					if (group.style.opacity !== "0") group.style.opacity = "0";
					return;
				}
				if (group.style.opacity !== "1") group.style.opacity = "1";
				if (!currentState || currentState.d !== nextState.d) path.setAttribute("d", nextState.d);
				if (!currentState || currentState.headD !== nextState.headD) head.setAttribute("d", nextState.headD);
				arrow.currentState = nextState;
			});

			requestAnimationFrame(loop);
		}

		document.addEventListener('astro:page-load', () => {
			setTimeout(() => {
				initArrows();
				requestAnimationFrame(loop);
			}, 500);
		});
	}
</script>
