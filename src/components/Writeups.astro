---
import { getCollection } from 'astro:content';

// Get posts, sort by date descending, take top 4
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<section id="writeups" class="py-24 md:py-32">
  <div class="max-w-[1100px] mx-auto px-6">
    <div class="flex items-center gap-4 mb-16 reveal">
      <span class="text-xs font-mono text-blue-400 tracking-wider">04.8</span>
      <div class="h-px flex-1 bg-zinc-800"></div>
      <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-500">CTF Writeups & Notes</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6 stagger">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="group p-6 border border-zinc-800 rounded-xl hover:border-zinc-700 transition-all duration-300 reveal cursor-pointer relative overflow-hidden h-full flex flex-col block">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative z-10 flex flex-col flex-1">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
              <span class="text-[11px] font-mono uppercase tracking-wider text-blue-400 bg-blue-400/10 px-2.5 py-1 rounded-md border border-blue-400/20">
                {post.data.type || post.data.tags?.[0] || 'Article'}
              </span>
              <span class="text-xs font-mono text-zinc-500">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-200 mb-2">
              {post.data.title}
            </h3>
            <p class="text-sm text-zinc-400 mt-auto pt-4 line-clamp-2">
              {post.data.description}
            </p>
          </div>
        </a>
      ))}
    </div>
    
    <div class="mt-12 text-center reveal">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-mono uppercase tracking-widest text-zinc-400 hover:text-white transition-colors duration-200">
        View All Writeups
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
