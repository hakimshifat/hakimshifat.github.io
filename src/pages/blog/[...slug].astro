---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props as CollectionEntry<'blog'>;
const { Content } = await post.render();
---

<Layout title={`${post.data.title} | Abdul Hakim Shifat`} description={post.data.description}>
  <Navbar />
  
  <main class="min-h-screen pt-32 pb-24">
    <div class="max-w-[800px] mx-auto px-6">
      <div class="mb-12 reveal">
        <a href="/blog" class="text-xs font-mono uppercase tracking-widest text-zinc-500 hover:text-blue-400 transition-colors mb-8 inline-block">
          ← Back to Archive
        </a>
        <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight mb-6">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-4 text-sm font-mono text-zinc-400">
          <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>·</span>
          <span>{post.data.tags?.join(', ') || 'Writeup'}</span>
        </div>
      </div>

      <article class="prose max-w-none reveal">
        <Content />
      </article>
    </div>
  </main>
  
  <Footer />
</Layout>

<style is:global>
  /* Minimalist markdown styling overriding default browser styles */
  .prose {
    color: var(--text-secondary);
    line-height: 1.8;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    color: var(--text);
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 1em;
    line-height: 1.3;
  }
  .prose h1 { font-size: 2.25em; }
  .prose h2 { font-size: 1.5em; border-bottom: 1px solid var(--border); padding-bottom: 0.3em; }
  .prose h3 { font-size: 1.25em; }
  .prose p { margin-bottom: 1.5em; }
  .prose a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
  .prose a:hover { border-bottom-color: var(--accent); }
  .prose strong { color: var(--text); font-weight: 600; }
  .prose ul { list-style-type: disc; padding-left: 1.5em; margin-bottom: 1.5em; }
  .prose ol { list-style-type: decimal; padding-left: 1.5em; margin-bottom: 1.5em; }
  .prose li { margin-bottom: 0.5em; }
  .prose blockquote { border-left: 4px solid var(--border); padding-left: 1em; color: var(--text-muted); font-style: italic; margin: 2em 0; }
  .prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.875em; background: var(--bg-elevated); padding: 0.2em 0.4em; border-radius: 0.25em; color: var(--text); border: 1px solid var(--border); }
  .prose pre { background: var(--bg-elevated) !important; padding: 1.25em; border-radius: 0.5em; overflow-x: auto; margin: 2em 0; border: 1px solid var(--border); }
  .prose pre code { background: transparent; padding: 0; border: none; color: inherit; }
  .prose img { border-radius: 0.5em; border: 1px solid var(--border); margin: 2em auto; display: block; max-width: 100%; height: auto; }
</style>
