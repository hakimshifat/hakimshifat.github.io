---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Archive | Abdul Hakim Shifat">
  <Navbar />
  <main id="main-content" class="min-h-screen pt-32 pb-24">
    <div class="max-w-[1100px] mx-auto px-6">
      <div class="flex items-center gap-4 mb-16 reveal">
        <div class="h-px w-8 bg-zinc-800"></div>
        <h1 class="text-xs font-mono uppercase tracking-[0.25em] text-zinc-500">All Writing ({posts.length})</h1>
        <div class="h-px flex-1 bg-zinc-800"></div>
      </div>
      
      <div class="mb-10 reveal">
        <label for="archive-search" class="block text-xs font-mono uppercase tracking-[0.2em] text-zinc-500 mb-3">Search the archive</label>
        <input
          id="archive-search"
          type="search"
          placeholder="Try Linux, reverse engineering, or CTF"
          class="w-full rounded-lg border border-zinc-800 bg-zinc-900/40 px-4 py-3 text-sm text-white placeholder:text-zinc-600 focus:border-blue-500 focus:outline-none"
        />
        <p id="archive-results-count" class="mt-3 text-xs font-mono text-zinc-500" aria-live="polite">Showing {posts.length} published notes</p>
      </div>

      <div id="archive-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}`}
            data-search-card
            data-search={`${post.data.title} ${post.data.description} ${post.data.type} ${post.data.tags.join(' ')}`.toLowerCase()}
            class="group p-6 border border-zinc-800 rounded-xl hover:border-zinc-700 hover:bg-zinc-900/30 transition-all duration-300 reveal cursor-pointer relative overflow-hidden h-full flex flex-col block"
          >
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            {post.data.heroImage?.trim().startsWith('/images/') && (
              <div class="relative z-10 -mx-6 -mt-6 mb-5 h-36 overflow-hidden border-b border-zinc-800 bg-zinc-900">
                <img src={post.data.heroImage.trim()} alt="" loading="lazy" class="h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100" />
              </div>
            )}
            <div class="relative z-10 flex flex-col flex-1">
              <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                <span class="text-[11px] font-mono uppercase tracking-wider text-blue-400 bg-blue-400/10 px-2.5 py-1 rounded-md border border-blue-400/20">
                  {post.data.type || post.data.tags?.[0] || 'Article'}
                </span>
                <span class="text-xs font-mono text-zinc-500">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </span>
              </div>
              <h3 class="text-lg font-semibold text-white group-hover:text-blue-400 transition-colors duration-200 mb-2">
                {post.data.title}
              </h3>
              <p class="text-sm text-zinc-400 mt-auto pt-4 line-clamp-3">
                {post.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('archive-search') as HTMLInputElement | null;
  const resultCount = document.getElementById('archive-results-count');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-search-card]'));

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = !query || card.dataset.search?.includes(query);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (resultCount) {
      resultCount.textContent = query
        ? `Showing ${visibleCount} matching note${visibleCount === 1 ? '' : 's'}`
        : `Showing ${cards.length} published notes`;
    }
  });
</script>
