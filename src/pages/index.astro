---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Axenide">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-content">
			<h1 class="hero-title">
				<span class="hero-title-text">Joyboy__</span>
			</h1>
			<div class="hero-intro">
				<p>
					I'm <a href="/about" class="accent-link">Abdul Hakim Shifat</a>, known online as <span class="accent-highlight">Joyboy__</span>.
					I build security tools, solve CTF challenges, and explore Linux and low-level systems.
					My work blends software engineering, research, and open-source craftsmanship.
				</p>
			</div>
			<div class="hero-status">
				<span class="status-badge">
					<span class="status-dot"></span>
					STATUS: <span class="status-text">OVERCLOCKED</span>
				</span>
			</div>
		</div>
		<div class="hero-card">
			<div class="hero-card-inner">
				<img src="/abdulhakim.png" alt="Profile" class="hero-card-image" />
				<div class="hero-card-overlay"></div>
			</div>
		</div>
	</section>

	<!-- Scroll hint -->
	<div class="scroll-hint pb-24">
		<p class="scroll-hint-text">Pssst...<br/>There's more.</p>
		<svg class="scroll-hint-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M12 5v14M19 12l-7 7-7-7" />
		</svg>
	</div>

	<!-- About Section -->
	<section class="content-section" id="about">
		<h2 class="section-title">About</h2>
		
		<div class="bento-grid">
			<!-- Polymath Card -->
			<div class="bento-card bento-wide">
				<div class="card-image-wrapper">
					<img src="/cover.jpg" alt="Space" class="card-image" />
				</div>
				<div class="card-header">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent-yellow)" stroke="var(--accent-yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
					</svg>
					<span>I am a security researcher and software builder.</span>
				</div>
				<p class="card-text">
					I'm from Bangladesh, and I love turning difficult problems into working systems, open-source tools, and practical experiments. <span style="font-family: monospace;">ᕙ(͡°‿ ͡°)ᕗ</span>
				</p>
				<p class="card-text">
					I'm <span id="age" class="age-counter">24.000000000</span> years old and still learning something new every day.
				</p>
				<p class="card-text mt-3">
					Most days I split my time between CTF research, Linux tinkering, and documenting my work in blog posts.
				</p>
				<p class="card-text mt-3">
					I enjoy building tools, writing writeups, and sharing what I learn with the community.
				</p>
			</div>

			<!-- CS Engineering Card -->
			<div class="bento-card">
				<div class="card-image-wrapper">
					<div class="placeholder-img bg-axe-hover flex items-center justify-center">
						<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--axe-muted)" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
					</div>
				</div>
				<div class="card-header">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent-purple)" stroke="var(--accent-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="6" width="20" height="12" rx="2"></rect>
						<path d="M12 12h.01"></path>
						<path d="M17 12h.01"></path>
						<path d="M7 12h.01"></path>
					</svg>
					<span>I study computer science engineering.</span>
				</div>
				<p class="card-text">
					My curiosity about computers led me into this field, where I get to merge systems thinking with security tooling and software craftsmanship.
				</p>
			</div>

			<!-- Hyperfixations Card -->
			<div class="bento-card">
				<div class="card-header">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent-yellow)" stroke="var(--accent-yellow)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
					</svg>
					<span>Hyperfixations:</span>
				</div>
				<ul class="block-list">
					<li>Linux</li>
					<li>Open Source</li>
					<li>System Architecture</li>
					<li>Cybersecurity / CTF</li>
					<li>Competitive Programming</li>
					<li>Dark Souls</li>
				</ul>
			</div>

			<!-- Contributions Card -->
			<div class="bento-card bento-wide">
				<div class="card-header justify-center mb-0">
					<span>GitHub Contributions</span>
				</div>
				<div class="github-graph-placeholder mt-2">
					<img src="https://raw.githubusercontent.com/hakimshifat/hakimshifat/output/snake.svg" alt="GitHub Contributions Snake" class="w-full object-cover mix-blend-screen opacity-90" />
				</div>
				<p class="card-text">
					I contribute to open-source tools, publish CTF writeups, and keep my GitHub active with security experiments, Linux utilities, and research notes.
				</p>
			</div>


			<!-- Tech Stack Card -->
			<div class="bento-card bento-wide">
				<div class="card-header">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
					</svg>
					<span>Tech Stack:</span>
				</div>
				<p class="card-text mb-4">
					The main technologies and frameworks I use to build scalable, user-centric applications:
				</p>
				<div class="flex flex-wrap gap-2">
					<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">Python</span>
				<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">C</span>
				<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">C++</span>
				<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">JavaScript</span>
				<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">Astro</span>
				<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">Linux</span>
				<span class="bg-axe-hover px-3 py-1 rounded text-sm text-axe-fg border border-white/10">Docker</span>
			</div>
		</div>
	</section>

	<!-- IndieWeb Section -->
	<section class="content-section" id="indieweb">
		<h2 class="section-title">IndieWeb</h2>
		<p class="card-text">
			Simply put, IndieWeb is anything on the web that is hand-crafted, feels personal and gives a retro feel.
		</p>
		<p class="card-text mt-4">
			Cozy and nostalgic, like the early days of the internet. Since I became an adult, I felt this strong urge to recreate that feeling of wonder and excitement I had when I first explored the web as a kid.
		</p>
		<p class="card-text mt-4">
			Also, I had a lot of fun making my own 88x31 button, and you should make one too! :)
		</p>

		<div class="badges-container mt-6">
			<div class="badges-header">
				<span>Badges <span class="text-xs text-axe-muted">AKA 88x31 buttons</span></span>
				<span class="text-axe-muted">+</span>
			</div>
			<div class="badges-list">
				<img src="/media/joyboy.gif" class="badge-item object-cover" alt="Arch Linux" />
			</div>
		</div>
	</section>

	<!-- Online Section -->
	<section class="content-section" id="online">
		<h2 class="section-title">Online</h2>
		<p class="section-subtitle">Where and when to find me online.</p>

		<div class="online-grid">
			<!-- Left Column -->
			<div class="online-col">
				<!-- Music Widget -->
				<div class="bento-card music-card flex items-center gap-4">
					<img src="/media/bonolota.png" class="music-cover object-cover" alt="Album Cover" />
					<div class="flex-1">
						<div class="text-xs text-axe-muted">Last Played</div>
						<div class="font-bold">paranoia</div>
						<div class="text-xs text-axe-muted">KENTENSHI</div>
					</div>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polygon points="5 3 19 12 5 21 5 3"></polygon>
					</svg>
				</div>

				<!-- Socials -->
				<div class="bento-card mt-4">
					<h3 class="online-category">Socials</h3>
					<div class="socials-grid">
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
							<span>YouTube</span>
						</a>
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2H3v16h5v4l4-4h5l4-4V2zM11 11V7M16 11V7"></path></svg>
							<span>Twitch</span>
						</a>
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
							<span>X / Twitter</span>
						</a>
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
							<span>Instagram</span>
						</a>
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M16 11a4 4 0 0 0-8 0"></path><circle cx="9" cy="9" r="1"></circle><circle cx="15" cy="9" r="1"></circle></svg>
							<span>Reddit</span>
						</a>
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"></path><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
							<span>Bluesky</span>
						</a>
					</div>
				</div>

				<!-- Code -->
				<div class="bento-card mt-4">
					<h3 class="online-category">Code</h3>
					<a href="https://github.com/hakimshifat" target="_blank" rel="noopener" class="online-link w-full">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
						<span>GitHub</span>
					</a>
				</div>
			</div>

			<!-- Right Column -->
			<div class="online-col">
				<!-- Contacts -->
				<div class="bento-card">
					<h3 class="online-category">Contacts</h3>
					<p class="text-xs text-axe-muted mb-2">For me it's currently <span class="bg-axe-hover px-1 rounded">07:22</span> (UTC-3) and I'm <span class="bg-axe-hover px-1 rounded">Offline</span>.</p>
					<p class="text-sm mb-4">Feel free to reach me out on any of these!</p>
					<div class="socials-grid">
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
							<span>Discord</span>
						</a>
						<a href="#" class="online-link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
							<span>Email</span>
						</a>
					</div>
				</div>

				<!-- AxLab banner -->
				<div class="bento-card mt-4 flex items-center justify-between">
					<div>
						<div class="flex items-center gap-2 mb-2">
							<span class="font-bold text-accent-red">AxLab</span>
							<span class="text-xs text-axe-muted"><span class="text-accent-yellow">■</span> 194 / <span class="text-axe-muted">■</span> 1429</span>
						</div>
						<div class="text-xs text-axe-muted">Built for creation.</div>
					</div>
					<img src="/abdulhakim.png" class="axlab-logo object-cover" alt="AxLab" />
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		// Age Calculator
		(function() {
			const ageEl = document.getElementById('age');
			if (!ageEl) return;

			const birth = new Date('2003-02-27T00:00:00Z').getTime() / 1000;
			const yearSeconds = 31556926;

			function update() {
				const now = Date.now() / 1000;
				const age = (now - birth) / yearSeconds;
				ageEl.textContent = age.toFixed(9);
			}

			setInterval(update, 50);
			update();
		})();
	</script>
</Layout>

<style>
	/* Hero */
	.hero-section {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		padding: 4rem 0 2rem;
		flex-wrap: wrap;
	}

	.hero-content {
		flex: 1;
		min-width: 300px;
	}

	.hero-title {
		margin: 0 0 1.5rem;
	}

	.hero-title-text {
		font-size: 3.5rem;
		font-weight: 900;
		letter-spacing: -0.03em;
		color: #e03131;
		text-shadow: 0 0 40px rgba(224, 49, 49, 0.3);
		font-family: 'Roboto Condensed', sans-serif;
	}

	.hero-intro {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--fg-muted, #999);
		max-width: 480px;
	}

	.accent-link {
		color: #e03131;
		text-decoration: underline;
		text-decoration-color: rgba(224, 49, 49, 0.3);
		text-underline-offset: 3px;
		transition: text-decoration-color 0.2s;
	}

	.accent-link:hover {
		text-decoration-color: #e03131;
	}

	.accent-highlight {
		color: #e03131;
		font-weight: 600;
	}

	.hero-status {
		margin-top: 1.5rem;
	}

	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.8rem;
		background: rgba(224, 49, 49, 0.1);
		border: 1px solid rgba(224, 49, 49, 0.2);
		border-radius: 6px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #999;
		text-transform: uppercase;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #e03131;
		animation: pulse-dot 2s ease-in-out infinite;
	}

	.status-text {
		color: #e03131;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	/* Hero Card */
	.hero-card {
		flex-shrink: 0;
	}

	.hero-card-inner {
		width: 220px;
		height: 280px;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		position: relative;
		transform: rotate(3deg);
		transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
	}

	.hero-card-inner:hover {
		transform: rotate(-1deg) scale(1.03);
	}

	.hero-card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-card-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 40%;
		background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
	}

	/* Scroll Hint */
	.scroll-hint {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 3rem 0;
		color: #555;
		font-style: italic;
		font-size: 0.9rem;
	}

	.scroll-hint-text {
		text-align: center;
	}

	.scroll-hint-arrow {
		animation: bounce-arrow 2s ease-in-out infinite;
	}

	@keyframes bounce-arrow {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(6px); }
	}

	/* Content Sections */
	.content-section {
		padding: 3rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	#about {
		padding-top: 15rem;
	}

	.section-title {
		font-size: 1.8rem;
		font-weight: 700;
		color: #e5e5e5;
		margin-bottom: 0.5rem;
		font-family: 'Roboto Condensed', sans-serif;
	}

	.section-subtitle {
		color: #666;
		font-size: 0.9rem;
		margin-bottom: 1.5rem;
	}

	/* Bento Grid */
	.bento-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.bento-card {
		background: #141414;
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		padding: 1.25rem;
		transition: border-color 0.3s, background-color 0.3s;
	}

	.bento-card:hover {
		border-color: rgba(255, 255, 255, 0.12);
		background: #1a1a1a;
	}

	.bento-wide {
		grid-column: span 2;
	}

	.card-image-wrapper {
		margin: -1.25rem -1.25rem 1.25rem -1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		overflow: hidden;
		border-radius: 12px 12px 0 0;
	}

	.card-image {
		width: 100%;
		height: 120px;
		object-fit: cover;
		display: block;
	}

	.placeholder-img {
		width: 100%;
		height: 120px;
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		color: #e5e5e5;
		margin-bottom: 1rem;
		font-size: 0.95rem;
	}

	.card-text {
		color: #888;
		font-size: 0.85rem;
		line-height: 1.6;
	}

	/* Age Counter */
	.age-counter {
		background: rgba(255,255,255,0.05);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.8rem;
		color: #ccc;
	}

	/* Block List */
	.block-list {
		display: flex;
		flex-direction: column;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.block-list li {
		padding: 10px 12px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
		color: #ccc;
		font-size: 0.85rem;
		transition: background-color 0.2s;
	}

	.block-list li:hover {
		background: rgba(255, 255, 255, 0.02);
	}

	.block-list li:last-child {
		border-bottom: none;
	}

	/* Graph */
	.github-graph-placeholder {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-bottom: 1rem;
		align-items: center;
	}
	.graph-row {
		display: flex;
		gap: 4px;
	}
	.graph-row span {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 2px;
