---
import Layout from '../layouts/Layout.astro';
import { ExternalLink, Trophy, Calendar, MapPin, Users, Terminal, Image as ImageIcon } from 'lucide-react';
const achievements = [
	{
		title: "TexSAW 2026",
		position: "22nd",
		date: "Feb 2026",
		type: "international"
	},
	{
		title: "UMDCTF 2026",
		position: "21st",
		date: "2026",
		type: "international"
	},
	{
		title: "CTF@AC26 - Quals",
		position: "22nd",
		date: "2026",
		type: "international"
	},
	{
		title: "squ1rrel CTF 2026",
		position: "43rd",
		date: "2026",
		type: "international"
	},
	{
		title: "pingCTF 2026",
		position: "44th",
		date: "2026",
		type: "international"
	},
	{
		title: "BUET CTF",
		position: "7th",
		date: "Jan 2026",
		type: "national"
	},
	{
		title: "Al-Khwarizmi CTF 2025 Preliminary Round(Finalist)",
		position: "11th",
		date: "Dec 2025",
		type: "national"
	},
	{
		title: "Circuit Clash 1.0 CTF",
		position: "6th",
		date: "Nov 2025",
		type: "national"
	},
	{
		title: "StealthFlags 2025 CTF in Televerse 1.0 by CUET",
		position: "13th",
		date: "Nov 2025",
		type: "national"
	},
	{
		title: "DIU CyberCon National CTF",
		position: "7th",
		date: "Oct 2025",
		type: "national"
	},
	{
		title: "2025 ICPC Asia Dhaka Regional Preliminary",
		position: "Participated",
		description: "Team: Brain_Breakers",
		date: "2025"
	},
	{
		title: "2024 ICPC Asia Dhaka Regional Preliminary",
		position: "Participated",
		description: "Team: Missing_Semicolon",
		date: "2024"
	},
	{
		title: "2023 ICPC Asia Dhaka Regional Preliminary",
		position: "Participated",
		description: "Team: BUP_ENOMEM_403",
		date: "2023"
	},
	{
		title: "BUP CTF 2025",
		position: "Participated",
		date: "Sep 2025"
	},
	{
		title: "DUET IUPC 2025",
		position: "Participated",
		date: "May 2025"
	},
	{
		title: "DUET ICT Olympiad",
		position: "Participated",
		date: "May 2025"
	},
	{
		title: "AUST IUPC 2025",
		position: "Participated",
		date: "Feb 2025"
	}
];

const internationalPlacements = achievements.filter(a => a.type === 'international' && !a.position.includes('Participated'));
const nationalPlacements = achievements.filter(a => a.type === 'national' && !a.position.includes('Participated'));
const participations = achievements.filter(a => a.position.includes('Participated'));
---

<Layout title="ACHIEVEMENTS // Portfolio_OS">
	<div class="grid-lines fixed inset-0 pointer-events-none z-0"></div>

	<div class="relative z-10">
		<header class="py-16 border-b border-[var(--line)] mb-12 text-center flex flex-col items-center">
			<h1 class="text-6xl md:text-7xl font-display italic tracking-tighter text-[var(--ink)] mb-4 typing-effect mx-auto">Achievements</h1>
			<p class="font-mono text-sm uppercase tracking-widest text-[var(--ink-secondary)]">Competitions & Awards</p>
		</header>

		{/* International CTFs Section */}
		<section class="mb-20">
			<h2 class="text-2xl font-mono uppercase tracking-widest text-[var(--ink)] mb-8 border-l-4 border-[var(--accent)] pl-4">International CTFs</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{internationalPlacements.map((item) => (
					<div class="p-8 border border-[var(--line)] border-l-4 border-l-[var(--accent)] bg-gradient-to-br from-[var(--bg-secondary)] to-[var(--bg)] hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-500 flex flex-col h-full group relative overflow-hidden">
						
						{/* Faint Cyber Pattern Overlay */}
						<div class="absolute inset-0 bg-[radial-gradient(var(--line)_1px,transparent_1px)] [background-size:16px_16px] opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none"></div>

						<div class="relative z-10 flex flex-col h-full">
							{/* Top Header */}

							{/* Invisible button to trigger modal */}
							{item.images && item.images.length > 0 && (
								<button 
									class="absolute inset-0 z-10 w-full h-full cursor-pointer opacity-0"
									data-images={JSON.stringify(item.images)}
									data-title={item.title}
									aria-label={`View images for ${item.title}`}
								></button>
							)}

							{/* Title */}
							<h3 class="text-xl font-display font-bold text-[var(--ink)] mb-6 leading-snug group-hover:italic transition-all">>_ {item.title}</h3>

							{/* Metadata List */}
							<div class="flex flex-col gap-4 mb-6 flex-grow">
								{/* Rank Badge */}
								<div class="inline-block self-start bg-[var(--accent)] text-[var(--bg)] px-3 py-1 text-sm font-mono font-bold uppercase tracking-wider">
									{item.position} Place
								</div>
								
								<div class="flex items-center gap-3 text-sm font-mono mt-2">
									<Calendar className="w-4 h-4 text-blue-400" />
									<span class="text-[var(--ink-secondary)]">{item.date}</span>
								</div>

								{item.images && item.images.length > 0 && (
									<div class="flex items-center gap-3 text-sm font-mono mt-2 text-[var(--accent)] group-hover:underline relative z-20 pointer-events-none">
										<ImageIcon className="w-4 h-4" />
										<span>View {item.images.length} Image{item.images.length > 1 ? 's' : ''}</span>
									</div>
								)}

								{/* Optional Location/Team placeholders based on inspiration */}
								{item.location && (
									<div class="flex items-center gap-3 text-sm font-mono">
										<MapPin className="w-4 h-4 text-green-400" />
										<span class="text-[var(--ink-secondary)]">{item.location}</span>
									</div>
								)}
								{item.team && (
									<div class="flex items-center gap-3 text-sm font-mono">
										<Users className="w-4 h-4 text-purple-400" />
										<span class="text-[var(--ink-secondary)]">{item.team}</span>
									</div>
								)}
							</div>

							{/* Optional Description */}
							{item.description && (
								<div class="text-sm text-[var(--ink-secondary)] font-light leading-relaxed pt-4 border-t border-[var(--line)]">
									<p>{item.description}</p>
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</section>

		{/* National CTFs Section */}
		<section class="mb-20">
			<h2 class="text-2xl font-mono uppercase tracking-widest text-[var(--ink)] mb-8 border-l-4 border-[var(--accent)] pl-4">National CTFs</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{nationalPlacements.map((item) => (
					<div class="p-8 border border-[var(--line)] border-l-4 border-l-[var(--accent)] bg-gradient-to-br from-[var(--bg-secondary)] to-[var(--bg)] hover:border-[var(--accent)] hover:-translate-y-1 hover:shadow-xl transition-all duration-500 flex flex-col h-full group relative overflow-hidden">
						
						{/* Faint Cyber Pattern Overlay */}
						<div class="absolute inset-0 bg-[radial-gradient(var(--line)_1px,transparent_1px)] [background-size:16px_16px] opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none"></div>

						<div class="relative z-10 flex flex-col h-full">
							{/* Top Header */}

							{/* Invisible button to trigger modal */}
							{item.images && item.images.length > 0 && (
								<button 
									class="absolute inset-0 z-10 w-full h-full cursor-pointer opacity-0"
									data-images={JSON.stringify(item.images)}
									data-title={item.title}
									aria-label={`View images for ${item.title}`}
								></button>
							)}

							{/* Title */}
							<h3 class="text-xl font-display font-bold text-[var(--ink)] mb-6 leading-snug group-hover:italic transition-all">>_ {item.title}</h3>

							{/* Metadata List */}
							<div class="flex flex-col gap-4 mb-6 flex-grow">
								{/* Rank Badge */}
								<div class="inline-block self-start bg-[var(--accent)] text-[var(--bg)] px-3 py-1 text-sm font-mono font-bold uppercase tracking-wider">
									{item.position} Place
								</div>
								
								<div class="flex items-center gap-3 text-sm font-mono mt-2">
									<Calendar className="w-4 h-4 text-blue-400" />
									<span class="text-[var(--ink-secondary)]">{item.date}</span>
								</div>

								{item.images && item.images.length > 0 && (
									<div class="flex items-center gap-3 text-sm font-mono mt-2 text-[var(--accent)] group-hover:underline relative z-20 pointer-events-none">
										<ImageIcon className="w-4 h-4" />
										<span>View {item.images.length} Image{item.images.length > 1 ? 's' : ''}</span>
									</div>
								)}

								{/* Optional Location/Team placeholders based on inspiration */}
								{item.location && (
									<div class="flex items-center gap-3 text-sm font-mono">
										<MapPin className="w-4 h-4 text-green-400" />
										<span class="text-[var(--ink-secondary)]">{item.location}</span>
									</div>
								)}
								{item.team && (
									<div class="flex items-center gap-3 text-sm font-mono">
										<Users className="w-4 h-4 text-purple-400" />
										<span class="text-[var(--ink-secondary)]">{item.team}</span>
									</div>
								)}
							</div>

							{/* Optional Description */}
							{item.description && (
								<div class="text-sm text-[var(--ink-secondary)] font-light leading-relaxed pt-4 border-t border-[var(--line)]">
									<p>{item.description}</p>
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</section>

		{/* Participations Section */}
		<section class="mb-20">
			<h2 class="text-2xl font-mono uppercase tracking-widest text-[var(--ink-secondary)] mb-8 border-l-4 border-[var(--line)] pl-4">Other Participations</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{participations.map((item) => (
					<div class="p-8 border border-[var(--line)] border-l-2 border-l-[var(--line)] bg-[var(--bg-secondary)] hover:border-[var(--accent)] hover:border-l-[var(--accent)] hover:-translate-y-1 hover:shadow-lg transition-all duration-500 flex flex-col h-full group relative">
						
						{/* Top Header */}
						<div class="flex justify-between items-start mb-6">
							<div class="text-[var(--ink-secondary)] font-mono text-xs uppercase tracking-widest bg-[var(--bg)] px-2 py-1 rounded-sm border border-[var(--line)] group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-colors">
								Participation
							</div>
							<a href={item.link || "#"} class="text-[var(--ink-muted)] hover:text-[var(--accent)] transition-all duration-300 hover:-translate-y-0.5 hover:translate-x-0.5 inline-block relative z-20">
								<ExternalLink className="w-4 h-4" />
							</a>
						</div>

						{/* Invisible button to trigger modal */}
						{item.images && item.images.length > 0 && (
							<button 
								class="absolute inset-0 z-10 w-full h-full cursor-pointer opacity-0"
								data-images={JSON.stringify(item.images)}
								data-title={item.title}
								aria-label={`View images for ${item.title}`}
							></button>
						)}

						{/* Title */}
						<h3 class="text-lg font-display text-[var(--ink)] group-hover:text-[var(--accent)] mb-6 leading-snug transition-colors">{item.title}</h3>

						{/* Metadata List */}
						<div class="flex flex-col gap-4 mt-auto">
							<div class="flex items-center gap-3 text-sm font-mono opacity-80 group-hover:opacity-100 transition-opacity">
								<Calendar className="w-4 h-4 text-blue-400 opacity-70 group-hover:opacity-100" />
								<span class="text-[var(--ink-secondary)] group-hover:text-[var(--ink)] transition-colors">{item.date}</span>
							</div>
							{item.images && item.images.length > 0 && (
								<div class="flex items-center gap-3 text-sm font-mono text-[var(--accent)] group-hover:underline relative z-20 pointer-events-none mt-1">
									<ImageIcon className="w-4 h-4" />
									<span>View Images</span>
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</section>
	</div>

		{/* Image Modal */}
		<dialog id="imageModal" class="bg-transparent m-auto p-4 w-full max-w-4xl backdrop:bg-[var(--bg)]/90 backdrop:backdrop-blur-sm open:flex flex-col z-50">
			<div class="bg-[var(--bg-secondary)] border border-[var(--accent)] w-full relative max-h-[90vh] flex flex-col shadow-[0_0_30px_var(--accent-muted)]">
				<div class="flex justify-between items-center p-4 border-b border-[var(--line)] bg-[var(--bg)]">
					<div class="flex items-center gap-2 text-[var(--accent)] font-mono text-sm font-bold">
						<Terminal className="w-4 h-4" />
						<span id="modalTitle">IMAGES</span>
					</div>
					<button id="closeModalBtn" class="text-[var(--ink-muted)] hover:text-[var(--accent)] transition-colors p-2 -mr-2">
						✕
					</button>
				</div>
				<div class="overflow-y-auto p-4 md:p-8 flex flex-col gap-8" id="modalImageContainer">
					{/* Images injected here */}
				</div>
			</div>
		</dialog>

	<script>
		const modal = document.getElementById('imageModal') as HTMLDialogElement;
		const closeBtn = document.getElementById('closeModalBtn');
		const container = document.getElementById('modalImageContainer');
		const titleEl = document.getElementById('modalTitle');
		
		const imageButtons = document.querySelectorAll('button[data-images]');
		
		imageButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				const imagesStr = btn.getAttribute('data-images');
				if (!imagesStr) return;
				
				const images = JSON.parse(imagesStr);
				const title = btn.getAttribute('data-title') || 'IMAGES';
				
				if (images.length > 0) {
					if(titleEl) titleEl.textContent = `>_ ${title}`;
					if(container) {
						container.innerHTML = '';
						images.forEach((src: string) => {
							const img = document.createElement('img');
							img.src = src;
							img.className = 'w-full h-auto border border-[var(--line)] shadow-lg';
							container.appendChild(img);
						});
					}
					modal?.showModal();
				}
			});
		});

		closeBtn?.addEventListener('click', () => {
			modal?.close();
		});

		modal?.addEventListener('click', (e) => {
			if (e.target === modal) {
				modal.close();
			}
		});
	</script>
</Layout>
