---
import Layout from '../layouts/Layout.astro';
import { Trophy, Code2, ExternalLink } from 'lucide-react';

const ctfTags = ["Forensics", "Networking", "Reverse Engineering", "Web", "OSINT", "PWN", "Steganography", "Cryptography"];
const cpTags = ["Searching", "Sorting", "Data Structures", "Range Query", "Graph", "Tree", "DP", "String", "Geometry"];

const cpPlatforms = [
	{
		name: "Codeforces",
		handle: "@hakimshifat",
		link: "https://codeforces.com/profile/hakimshifat",
		stats: {
			"Solved:": "465+",
			"Rating:": "1112",
			"Rank:": "Newbie"
		}
	},
	{
		name: "CodeChef",
		handle: "@hakimshifat",
		link: "https://www.codechef.com/users/hakimshifat",
		stats: {
			"Solved:": "120+",
			"Rating:": "1542",
			"Rank:": "2 ★"
		}
	},
	{
		name: "LeetCode",
		handle: "@hakimshifat",
		link: "https://leetcode.com/u/hakimshifat/",
		stats: {
			"Solved:": "106+"
		}
	},
	{
		name: "CSES",
		handle: "@hakimshifat",
		link: "https://cses.fi/user/hakimshifat",
		stats: {
			"Solved:": "30+"
		}
	}
];

const ctfPlatforms = [
	{
		name: "TryHackMe",
		handle: "@hakimshifat",
		link: "https://tryhackme.com/p/hakimshifat",
		stats: {},
		embed: "https://tryhackme-badges.s3.amazonaws.com/hakimshifat.png" // Fallback to a badge image if available
	},
	{
		name: "picoCTF",
		handle: "@hakimshifat",
		link: "https://play.picoctf.org/users/hakimshifat",
		stats: {
			"Solved:": "172"
		}
	}
];
---

<Layout title="PROFILES // Portfolio_OS">
	<div class="grid-lines fixed inset-0 pointer-events-none z-0"></div>

	<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6">
		<header class="py-12 border-b border-[var(--line)] mb-12 text-center md:text-left">
			<h1 class="text-6xl md:text-7xl font-display italic tracking-tighter text-[var(--ink)] mb-4 typing-effect">Coding Profiles</h1>
			<p class="font-mono text-sm uppercase tracking-widest text-[var(--ink-secondary)]">Platforms & Rankings</p>
		</header>

		{/* Summary Cards */}
		<section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-16">
			{/* CTF Card */}
			<div class="p-8 border border-[var(--line)] bg-[var(--bg-secondary)] hover:border-[var(--accent)] transition-all duration-500 group">
				<div class="flex items-center gap-4 mb-2">
					<div class="p-3 border border-[var(--line)] bg-[var(--bg)] group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-all">
						<Trophy className="w-6 h-6" />
					</div>
					<h2 class="text-2xl font-display text-[var(--ink)] typing-effect">Capture The Flag</h2>
				</div>
				<p class="text-[var(--ink-secondary)] font-light mb-6 md:ml-[68px]">CTF problems solved across multiple domains</p>
				
				<div class="flex items-center gap-2 mb-6 md:ml-[68px]">
					<div class="px-4 py-1.5 border border-[var(--line)] rounded-full text-sm font-mono text-[var(--ink)] bg-[var(--bg)] inline-flex items-center gap-2">
						<span class="w-2 h-2 rounded-full border border-[var(--ink)] inline-block"></span>
						200+ Problems Solved
					</div>
				</div>

				<div class="flex flex-wrap gap-2 md:ml-[68px]">
					{ctfTags.map(tag => (
						<span class="px-3 py-1 border border-red-900/50 text-red-500 bg-red-950/20 rounded-full text-xs font-mono tracking-wider hover:border-red-500/50 hover:bg-red-900/30 transition-colors cursor-default">
							{tag}
						</span>
					))}
				</div>
			</div>

			{/* CP Card */}
			<div class="p-8 border border-[var(--line)] bg-[var(--bg-secondary)] hover:border-[var(--accent)] transition-all duration-500 group">
				<div class="flex items-center gap-4 mb-2">
					<div class="p-3 border border-[var(--line)] bg-[var(--bg)] group-hover:border-[var(--accent)] group-hover:text-[var(--accent)] transition-all">
						<Code2 className="w-6 h-6" />
					</div>
					<h2 class="text-2xl font-display text-[var(--ink)] typing-effect">Competitive Programming</h2>
				</div>
				<p class="text-[var(--ink-secondary)] font-light mb-6 md:ml-[68px]">Coding problems solved across various topics</p>
				
				<div class="flex items-center gap-2 mb-6 md:ml-[68px]">
					<div class="px-4 py-1.5 border border-[var(--line)] rounded-full text-sm font-mono text-[var(--ink)] bg-[var(--bg)] inline-flex items-center gap-2">
						<span class="font-mono font-bold">&lt;/&gt;</span>
						750+ Problems Solved
					</div>
				</div>

				<div class="flex flex-wrap gap-2 md:ml-[68px]">
					{cpTags.map(tag => (
						<span class="px-3 py-1 border border-blue-900/50 text-blue-400 bg-blue-950/20 rounded-full text-xs font-mono tracking-wider hover:border-blue-500/50 hover:bg-blue-900/30 transition-colors cursor-default">
							{tag}
						</span>
					))}
				</div>
			</div>
		</section>

		{/* Competitive Programming Platforms */}
		<section class="mb-16">
			<h2 class="text-2xl font-display text-[var(--ink)] mb-8 pb-4 border-b border-[var(--line)]">Competitive Programming Platforms</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{cpPlatforms.map(platform => (
					<a href={platform.link} target="_blank" rel="noopener noreferrer" class="p-6 border border-[var(--line)] bg-[var(--bg-secondary)] hover:border-[var(--accent)] transition-all duration-500 group block relative flex flex-col h-full">
						<div class="absolute top-6 right-6 text-[var(--ink-muted)] group-hover:text-[var(--accent)] transition-colors">
							<ExternalLink className="w-4 h-4" />
						</div>
						
						<h3 class="text-xl font-display text-[var(--ink)] mb-8">{platform.name}</h3>
						
						<div class="flex-grow flex flex-col gap-3 mb-8">
							{Object.entries(platform.stats).map(([key, value]) => (
								<div class="flex justify-between items-center text-sm">
									<span class="font-mono text-[var(--ink-secondary)]">{key}</span>
									<span class="font-mono text-[var(--ink)] typing-effect">{value}</span>
								</div>
							))}
						</div>

						<p class="font-mono text-xs text-[var(--ink-muted)] mt-auto pt-4 border-t border-[var(--line)] group-hover:text-[var(--ink)] transition-colors">{platform.handle}</p>
					</a>
				))}
			</div>
		</section>

		{/* CTF Platforms */}
		<section class="mb-20">
			<h2 class="text-2xl font-display text-[var(--ink)] mb-8 pb-4 border-b border-[var(--line)]">CTF Platforms</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{ctfPlatforms.map(platform => (
					<a href={platform.link} target="_blank" rel="noopener noreferrer" class="p-6 border border-[var(--line)] bg-[var(--bg-secondary)] hover:border-[var(--accent)] transition-all duration-500 group block relative flex flex-col h-full">
						<div class="absolute top-6 right-6 text-[var(--ink-muted)] group-hover:text-[var(--accent)] transition-colors">
							<ExternalLink className="w-4 h-4" />
						</div>
						
						<h3 class="text-xl font-display text-[var(--ink)] mb-8">{platform.name}</h3>
						
						{Object.keys(platform.stats).length > 0 && (
							<div class="flex-grow flex flex-col gap-3 mb-8">
								{Object.entries(platform.stats).map(([key, value]) => (
									<div class="flex justify-between items-center text-sm">
										<span class="font-mono text-[var(--ink-secondary)]">{key}</span>
										<span class="font-mono text-[var(--ink)] typing-effect">{value}</span>
									</div>
								))}
							</div>
						)}

						{platform.embed && (
							<div class="mb-6 bg-[var(--bg)] overflow-hidden border border-[var(--line)] flex-grow">
								<img src={platform.embed} alt={`${platform.name} Badge`} class="w-full object-contain opacity-80 group-hover:opacity-100 transition-opacity" onerror="this.style.display='none'" />
							</div>
						)}

						<p class="font-mono text-xs text-[var(--ink-muted)] mt-auto pt-4 border-t border-[var(--line)] group-hover:text-[var(--ink)] transition-colors">{platform.handle}</p>
					</a>
				))}
			</div>
		</section>

	</div>
</Layout>
