---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

type CaseStudyProps = {
  study: CollectionEntry<'caseStudies'>;
};

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies', ({ data }) => !data.draft);
  return studies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props as CaseStudyProps;
const { Content } = await study.render();
const data = study.data;
---

<Layout title={`${data.title} Case Study | Abdul Hakim Shifat`} description={data.description}>
  <Navbar />
  <div id="case-reading-progress" aria-hidden="true"></div>
  <main id="main-content" class="case-study-page">
    <div class="case-study-container">
      <a href="/" class="case-back reveal"><span aria-hidden="true">←</span> Back to portfolio</a>

      <header class="case-hero reveal">
        <div class="case-hero-copy">
          <div class="case-eyebrow-row">
            <span class="case-eyebrow">{data.eyebrow}</span>
            <span class="case-index">CASE / {study.slug.toUpperCase()}</span>
          </div>
          <h1>{data.title}</h1>
          <p class="case-lede">{data.description}</p>
          <div class="case-meta-row" aria-label="Project metadata">
            <div><span>Role</span><strong>{data.role}</strong></div>
            <div><span>Period</span><strong>{data.year}</strong></div>
            <div><span>Category</span><strong>{data.category}</strong></div>
          </div>
          <div class="case-actions">
            <a href={data.repo} target="_blank" rel="noopener noreferrer" class="case-primary-action">View source repository <span aria-hidden="true">↗</span></a>
            <span class="case-proof-note"><span class="case-proof-dot"></span> Read from the actual codebase</span>
          </div>
        </div>

        <div class:list={['case-visual', `case-visual-${data.visual}`]} aria-label={`${data.title} project visual`}>
          {data.image ? (
            <div class="case-image-frame">
              <img src={data.image} alt={data.imageAlt || data.title} loading="eager" />
              <span class="case-image-label">Repository artifact / visual reference</span>
            </div>
          ) : data.visual === 'pipeline' ? (
            <div class="visual-pipeline">
              <div class="visual-label">EVALUATION PIPELINE</div>
              <div class="pipeline-node pipeline-node-source"><span>01</span> source artifacts</div>
              <div class="pipeline-line"></div>
              <div class="pipeline-node"><span>02</span> audit + manifest</div>
              <div class="pipeline-line"></div>
              <div class="pipeline-split"><div><span>D_POLICY</span></div><div><span>D_CAL</span></div><div><span>D_TEST_ADV</span></div></div>
              <div class="pipeline-line"></div>
              <div class="pipeline-result"><span class="result-mark">✓</span> frozen evidence</div>
            </div>
          ) : data.visual === 'camera' ? (
            <div class="visual-camera">
              <div class="visual-label">LOCAL CAMERA LOOP</div>
              <div class="camera-frame"><div class="face-outline"><i></i><i></i><b></b></div><div class="hand-outline">✦</div><span class="camera-crosshair">+</span></div>
              <div class="camera-readout"><span>FACE 72%</span><span>HAND 28%</span><span class="readout-good">MATCH 91</span></div>
              <div class="camera-controls"><kbd>[</kbd><kbd>T</kbd><kbd>]</kbd><span>teach active pose</span></div>
            </div>
          ) : data.visual === 'scanner' ? (
            <div class="visual-scanner">
              <div class="visual-label">STATIC SCAN / OFFLINE</div>
              <div class="scanner-file"><span class="file-icon">⌁</span><span>PKGBUILD</span><span class="file-state">INSPECTING</span></div>
              <div class="scan-lines"><span style="width: 88%"></span><span style="width: 64%"></span><span style="width: 76%"></span><span style="width: 42%"></span></div>
              <div class="scanner-findings"><div><b>R-014</b><span>mutable source</span><em>review</em></div><div><b>R-022</b><span>dynamic exec</span><em class="finding-high">block</em></div><div><b>R-031</b><span>checksum rule</span><em class="finding-pass">pass</em></div></div>
              <div class="scanner-footer"><span>coverage: explicit</span><span>exit: 2</span></div>
            </div>
          ) : data.visual === 'web' ? (
            <div class="visual-web">
              <div class="visual-label">SECURE INFORMATION FLOW</div>
              <div class="web-layer web-client"><span>01</span><b>React client</b><small>upload · auth · extract</small></div>
              <div class="web-connector">↓</div>
              <div class="web-layer web-api"><span>02</span><b>Express API</b><small>session · stego · logs</small></div>
              <div class="web-connector">↓</div>
              <div class="web-bottom"><div class="web-layer web-db"><span>03</span><b>PostgreSQL</b><small>Prisma sessions</small></div><div class="web-layer web-files"><span>04</span><b>PNG output</b><small>local storage</small></div></div>
            </div>
          ) : data.visual === 'boot' ? (
            <div class="visual-boot">
              <div class="visual-label">BOOT HANDOFF / 0x007C00</div>
              <div class="boot-row"><div><strong>BIOS</strong><small>POST + read sector 0</small></div><span>→</span><div class="boot-active"><strong>512 B</strong><small>real-mode setup</small></div><span>→</span><div><strong>KERNEL</strong><small>later stage</small></div></div>
              <div class="boot-memory"><span>0x0000</span><i></i><b>0x007C00</b><i></i><span>0xFFFFF</span></div>
              <div class="boot-signature"><span>sector signature</span><strong>55 AA</strong><span>bootable</span></div>
            </div>
          ) : (
            <div class="visual-terminal">
              <div class="visual-label">YTUI MUSIC / READY</div>
              <div class="terminal-command"><span>$</span> search lo-fi beats_</div>
              <div class="terminal-result active"><span>01</span><b>lofi hip hop radio</b><em>03:21:44</em></div>
              <div class="terminal-result"><span>02</span><b>late night coding mix</b><em>01:12:08</em></div>
              <div class="terminal-result"><span>03</span><b>ambient terminal session</b><em>02:04:31</em></div>
              <div class="terminal-status"><kbd>ENTER</kbd> play <kbd>j/k</kbd> navigate <kbd>SPACE</kbd> pause</div>
            </div>
          )}
        </div>
      </header>

      <section class="case-metrics reveal" aria-label="Project signals">
        {data.metrics.map((metric) => (
          <div class="case-metric"><span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.detail}</small></div>
        ))}
      </section>

      <section class="case-brief-grid reveal" aria-label="Case study brief">
        <div class="case-brief-card"><span class="case-card-label">The problem</span><p>{data.problem}</p></div>
        <div class="case-brief-card case-brief-card-accent"><span class="case-card-label">The outcome</span><p>{data.outcome}</p></div>
      </section>

      <div class="case-content-layout">
        <aside class="case-sidebar reveal">
          <div class="case-sidebar-block">
            <span class="case-card-label">Stack</span>
            <div class="case-stack">{data.stack.map((item) => <span>{item}</span>)}</div>
          </div>
          <div class="case-sidebar-block case-sidebar-note">
            <span class="case-card-label">Reading note</span>
            <p>This page focuses on the decisions, boundaries, and repository evidence behind the project—not just its feature list.</p>
          </div>
        </aside>
        <article class="case-study-body reveal" aria-label={`${data.title} case study`}>
          <Content />
        </article>
      </div>

      <footer class="case-footer reveal">
        <div><span class="case-card-label">Continue exploring</span><h2>See the implementation in context.</h2></div>
        <a href={data.repo} target="_blank" rel="noopener noreferrer" class="case-primary-action">Open repository <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const progress = document.getElementById('case-reading-progress');
  const article = document.querySelector('.case-study-body');
  const updateProgress = () => {
    if (!progress || !article) return;
    const bounds = article.getBoundingClientRect();
    const height = article.scrollHeight - window.innerHeight;
    const distance = Math.max(0, -bounds.top);
    progress.style.width = `${height > 0 ? Math.min(100, (distance / height) * 100) : 0}%`;
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
  document.querySelectorAll('.case-study-body pre').forEach((pre) => {
    if (pre.querySelector('.case-copy')) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'case-copy';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
        window.setTimeout(() => { button.textContent = 'Copy'; }, 1500);
      } catch {
        button.textContent = 'Select manually';
      }
    });
    pre.appendChild(button);
  });
</script>

<style is="global">
  .case-study-page { min-height: 100vh; padding: 8.5rem 0 7rem; background: var(--bg); }
  .case-study-container { width: min(1160px, calc(100% - 3rem)); margin: 0 auto; }
  #case-reading-progress { position: fixed; inset: 0 auto auto 0; z-index: 70; width: 0; height: 2px; background: var(--accent); box-shadow: 0 0 16px rgba(59,130,246,.6); transition: width .08s linear; }
  .case-back { display: inline-flex; align-items: center; gap: .55rem; color: var(--muted); font: 11px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; transition: color .2s ease; }
  .case-back:hover { color: var(--accent); }
  .case-hero { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(360px, .94fr); gap: 4.5rem; align-items: center; margin-top: 3.25rem; }
  .case-eyebrow-row { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-bottom: 1.65rem; }
  .case-eyebrow, .case-index, .case-card-label, .visual-label { font: 10px/1.2 var(--font-mono); letter-spacing: .2em; text-transform: uppercase; }
  .case-eyebrow { color: var(--accent); }
  .case-index { color: var(--muted-2); }
  .case-hero h1 { max-width: 720px; margin: 0; color: var(--text); font-size: clamp(2.8rem, 7vw, 6.2rem); line-height: .95; letter-spacing: -.065em; }
  .case-lede { max-width: 680px; margin: 1.65rem 0 0; color: var(--muted); font-size: clamp(1.05rem, 1.8vw, 1.3rem); line-height: 1.7; }
  .case-meta-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2.4rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .case-meta-row div { display: grid; gap: .4rem; }
  .case-meta-row span { color: var(--muted-2); font: 10px/1.2 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .case-meta-row strong { color: var(--text); font-size: .82rem; line-height: 1.45; font-weight: 500; }
  .case-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }
  .case-primary-action { display: inline-flex; align-items: center; gap: .7rem; padding: .8rem 1rem; border: 1px solid rgba(59,130,246,.55); border-radius: .55rem; background: rgba(59,130,246,.12); color: #dbeafe; font: 11px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; transition: border-color .2s ease, background .2s ease, transform .2s ease; }
  .case-primary-action:hover { border-color: var(--accent); background: rgba(59,130,246,.2); transform: translateY(-2px); }
  .case-proof-note { display: inline-flex; align-items: center; gap: .45rem; color: var(--muted-2); font: 10px/1.4 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .case-proof-dot { width: 5px; height: 5px; border-radius: 999px; background: #4ade80; box-shadow: 0 0 10px rgba(74,222,128,.6); }
  .case-visual { min-height: 420px; position: relative; overflow: hidden; border: 1px solid var(--border); border-radius: 1rem; background: radial-gradient(circle at 75% 20%, rgba(59,130,246,.12), transparent 38%), #0d0d10; box-shadow: 0 30px 80px rgba(0,0,0,.26); }
  .case-visual::before { position: absolute; inset: 0; content: ''; opacity: .45; background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(135deg, black, transparent 80%); }
  .case-visual > * { position: relative; z-index: 1; }
  .visual-label { color: var(--muted-2); }
  .visual-pipeline, .visual-camera, .visual-scanner, .visual-web, .visual-boot, .visual-terminal { display: flex; flex-direction: column; gap: 1rem; height: 100%; padding: 2rem; }
  .pipeline-node { display: flex; justify-content: space-between; align-items: center; width: 82%; padding: .95rem 1rem; border: 1px solid #27272a; border-radius: .45rem; background: rgba(24,24,27,.85); color: #d4d4d8; font: 11px/1.3 var(--font-mono); }
  .pipeline-node span { color: var(--accent); }
  .pipeline-node-source { margin-top: 1rem; }
  .pipeline-line { width: 1px; height: 1.2rem; margin-left: 1.2rem; background: #3f3f46; }
  .pipeline-split { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; width: 100%; }
  .pipeline-split div { min-height: 4.2rem; display: grid; place-items: center; border: 1px solid rgba(59,130,246,.35); border-radius: .45rem; background: rgba(59,130,246,.08); color: #93c5fd; font: 9px/1.2 var(--font-mono); text-align: center; }
  .pipeline-result { display: flex; align-items: center; gap: .55rem; margin-top: auto; color: #a7f3d0; font: 11px/1.3 var(--font-mono); }
  .result-mark { display: grid; width: 1.4rem; height: 1.4rem; place-items: center; border: 1px solid #34d399; border-radius: 50%; }
  .visual-camera { gap: .8rem; }
  .camera-frame { position: relative; display: grid; min-height: 255px; place-items: center; margin-top: .5rem; border: 1px solid #334155; border-radius: .65rem; background: radial-gradient(circle at 50% 40%, rgba(59,130,246,.16), transparent 28%), linear-gradient(150deg, #111827, #09090b 65%); }
  .face-outline { position: relative; width: 125px; height: 160px; border: 1px solid rgba(147,197,253,.75); border-radius: 48% 48% 44% 44% / 42% 42% 58% 58%; }
  .face-outline i { position: absolute; top: 62px; width: 14px; height: 6px; border-top: 1px solid #bfdbfe; }
  .face-outline i:first-child { left: 25px; }.face-outline i:nth-child(2) { right: 25px; }
  .face-outline b { position: absolute; bottom: 30px; left: 42px; width: 40px; height: 14px; border-bottom: 1px solid #60a5fa; border-radius: 50%; }
  .hand-outline { position: absolute; right: 19%; bottom: 22%; color: #60a5fa; font-size: 3rem; transform: rotate(-16deg); }
  .camera-crosshair { position: absolute; top: 13%; left: 12%; color: rgba(147,197,253,.4); font-size: 1.6rem; }
  .camera-readout, .camera-controls, .scanner-footer { display: flex; justify-content: space-between; gap: .75rem; color: var(--muted-2); font: 9px/1.3 var(--font-mono); letter-spacing: .08em; }
  .readout-good { color: #86efac; }.camera-controls { justify-content: flex-start; align-items: center; }.camera-controls kbd, .terminal-status kbd { padding: .22rem .35rem; border: 1px solid #3f3f46; border-radius: .25rem; color: #d4d4d8; }
  .visual-scanner { gap: 1rem; }.scanner-file { display: grid; grid-template-columns: auto 1fr auto; gap: .65rem; align-items: center; padding: .9rem; border: 1px solid #27272a; border-radius: .45rem; color: #e4e4e7; font: 11px/1.3 var(--font-mono); }.file-icon { color: var(--accent); font-size: 1.3rem; }.file-state { color: #fbbf24; font-size: 9px; }.scan-lines { display: grid; gap: .55rem; padding: .55rem 0; }.scan-lines span { display: block; height: 3px; border-radius: 99px; background: linear-gradient(90deg, #2563eb, rgba(37,99,235,.08)); }.scanner-findings { display: grid; gap: .5rem; }.scanner-findings div { display: grid; grid-template-columns: 3.5rem 1fr auto; gap: .55rem; align-items: center; padding: .65rem .7rem; border-left: 2px solid #f59e0b; background: rgba(245,158,11,.06); font: 10px/1.2 var(--font-mono); }.scanner-findings b { color: #fcd34d; }.scanner-findings span { color: #a1a1aa; }.scanner-findings em { color: #fbbf24; font-style: normal; text-transform: uppercase; }.scanner-findings .finding-high { color: #f87171; }.scanner-findings .finding-pass { color: #86efac; }.scanner-footer { margin-top: auto; }
  .visual-web { gap: .75rem; }.web-layer { display: grid; grid-template-columns: 2rem 1fr; column-gap: .6rem; padding: .85rem; border: 1px solid #334155; border-radius: .45rem; background: rgba(15,23,42,.78); }.web-layer span { grid-row: span 2; color: var(--accent); font: 10px/1.2 var(--font-mono); }.web-layer b { color: #e0f2fe; font: 12px/1.2 var(--font-mono); }.web-layer small { margin-top: .35rem; color: #94a3b8; font: 10px/1.2 var(--font-mono); }.web-connector { padding-left: 1.1rem; color: #60a5fa; font: 1rem/1 var(--font-mono); }.web-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
  .visual-boot { justify-content: center; }.boot-row { display: grid; grid-template-columns: 1fr auto 1.2fr auto 1fr; gap: .55rem; align-items: center; margin-top: 2rem; }.boot-row > div { min-height: 7rem; display: flex; flex-direction: column; justify-content: center; gap: .6rem; padding: .7rem; border: 1px solid #27272a; border-radius: .5rem; background: rgba(24,24,27,.86); }.boot-row strong { color: #e4e4e7; font: 13px/1 var(--font-mono); }.boot-row small { color: #71717a; font: 9px/1.4 var(--font-mono); }.boot-row > span { color: #60a5fa; font-size: 1.2rem; }.boot-active { border-color: rgba(59,130,246,.65) !important; background: rgba(59,130,246,.1) !important; }.boot-active strong { color: #93c5fd; }.boot-memory { display: flex; align-items: center; gap: .5rem; margin-top: auto; color: #71717a; font: 9px/1 var(--font-mono); }.boot-memory i { height: 1px; flex: 1; background: #3f3f46; }.boot-memory b { color: #93c5fd; font-weight: 400; }.boot-signature { display: flex; align-items: center; gap: .8rem; color: #71717a; font: 9px/1 var(--font-mono); }.boot-signature strong { color: #86efac; font-size: 1.1rem; letter-spacing: .12em; }
  .visual-terminal { gap: .8rem; background: rgba(0,0,0,.25); }.terminal-command { padding: .8rem; border-bottom: 1px solid #27272a; color: #d4d4d8; font: 12px/1.3 var(--font-mono); }.terminal-command span { color: #60a5fa; }.terminal-result { display: grid; grid-template-columns: 2rem 1fr auto; gap: .6rem; align-items: center; padding: .75rem; border: 1px solid transparent; color: #a1a1aa; font: 10px/1.3 var(--font-mono); }.terminal-result span { color: #52525b; }.terminal-result b { color: #d4d4d8; font-weight: 400; }.terminal-result em { color: #52525b; font-style: normal; }.terminal-result.active { border-color: rgba(59,130,246,.55); background: rgba(59,130,246,.09); }.terminal-result.active span, .terminal-result.active b { color: #93c5fd; }.terminal-status { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .65rem; margin-top: auto; color: #71717a; font: 9px/1.3 var(--font-mono); }
  .case-metrics { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 5rem; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }.case-metric { display: grid; gap: .55rem; min-height: 150px; padding: 1.35rem 1.5rem; border-right: 1px solid var(--border); }.case-metric:last-child { border-right: 0; }.case-metric span { color: var(--muted-2); font: 10px/1.2 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }.case-metric strong { color: var(--text); font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1; letter-spacing: -.04em; }.case-metric small { max-width: 250px; color: var(--muted); font-size: .76rem; line-height: 1.55; }
